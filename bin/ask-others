#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "openai",
#     "google-genai",
# ]
# ///
"""ask-others - Query GPT-5.2 and Gemini 3 Pro in parallel via METR middleman"""

import sys
import os
import concurrent.futures
from pathlib import Path


def load_env():
    env_file = Path.home() / "app" / ".env"
    if env_file.exists():
        for line in env_file.read_text().splitlines():
            if "=" in line and not line.startswith("#"):
                key, _, value = line.partition("=")
                # Strip surrounding quotes
                value = value.strip().strip("'\"")
                if key and key not in os.environ:
                    os.environ[key] = value


load_env()

from openai import OpenAI
from google import genai
import google.genai.types as genai_types


def ask_gpt(prompt: str) -> str:
    client = OpenAI(
        base_url=os.environ["OPENAI_BASE_URL"],
        api_key=os.environ["OPENAI_API_KEY"],
    )
    response = client.chat.completions.create(
        model="gpt-5.2",
        messages=[{"role": "user", "content": prompt}],
    )
    return response.choices[0].message.content


def ask_gemini(prompt: str) -> str:
    client = genai.Client(
        vertexai=True,
        api_key=os.environ["VERTEX_API_KEY"],
        http_options=genai_types.HttpOptions(
            base_url=os.environ["VERTEX_BASE_URL"],
        ),
    )
    response = client.models.generate_content(
        model="gemini-3-pro-preview",
        contents=prompt,
    )
    return response.text


def main():
    if len(sys.argv) < 2:
        print("Usage: ask-others <prompt>", file=sys.stderr)
        sys.exit(1)

    prompt = " ".join(sys.argv[1:])

    with concurrent.futures.ThreadPoolExecutor() as executor:
        gpt_future = executor.submit(ask_gpt, prompt)
        gemini_future = executor.submit(ask_gemini, prompt)

        gpt_response = gpt_future.result()
        gemini_response = gemini_future.result()

    print("=== GPT-5.2 ===")
    print(gpt_response)
    print()
    print("=== Gemini 3 Pro ===")
    print(gemini_response)


if __name__ == "__main__":
    main()
